{
  "name": "agent-plan-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "editor": "pnpm --filter agent-plan-core build && pnpm --filter agent-plan-editor dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm --filter agent-plan-core build && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "cli": "node agent-plan-cli/dist/index.js",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check .",
    "verify": "pnpm check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14"
  }
}
