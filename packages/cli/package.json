{
  "name": "soyori-cli",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Local command-line runner for Soyori flows.",
  "bin": {
    "soyori": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "soyori-ai": "workspace:*",
    "soyori-core": "workspace:*",
    "soyori-script": "workspace:*",
    "soyori-storage": "workspace:*",
    "commander": "15.0.0",
    "esbuild": "0.25.12",
    "yaml": "2.9.1",
    "soyori-tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qyjbeijing2017/soyori.git",
    "directory": "packages/cli"
  }
}
