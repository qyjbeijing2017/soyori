{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/.git",
      "!!**/tmp",
      "!!**/temp",
      "!!**/.agent-plan/storage",
      "!!**/.playwright-cli"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "off" },
      "suspicious": { "noThenProperty": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["**/tests/**"],
      "linter": { "rules": { "suspicious": { "noSparseArray": "off" } } }
    }
  ]
}
