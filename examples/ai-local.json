{
  "schemaVersion": 1,
  "name": "本地 AI 问答",
  "description": "首次运行下载 LFM 本地模型，不需要 API Key。",
  "fields": {
    "prompt": { "input": true, "initial": "请用中文写一句简短的欢迎语。" },
    "answer": { "output": true }
  },
  "steps": [
    {
      "type": "call",
      "target": { "kind": "function", "id": "local.generate" },
      "inputs": { "prompt": "$prompt", "maxTokens": 64 },
      "outputs": { "text": "$answer" }
    }
  ]
}
