{
  "schemaVersion": 1,
  "name": "Anthropic 问答",
  "description": "在宿主设置 ANTHROPIC_API_KEY 和 ANTHROPIC_MODEL，不把密钥写入流程。",
  "fields": {
    "prompt": { "input": true, "initial": "请用中文写一句简短的欢迎语。" },
    "result": { "output": true }
  },
  "steps": [
    {
      "type": "call",
      "target": "anthropic.generate",
      "inputs": { "prompt": "$prompt", "maxTokens": 128 },
      "output": "$result"
    }
  ]
}
