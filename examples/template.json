{
  "schemaVersion": 1,
  "name": "文本模板示例",
  "fields": {
    "chatIn": {
      "input": true,
      "initial": "你好"
    },
    "chatOut": {
      "output": true
    }
  },
  "steps": [
    {
      "type": "template",
      "template": "用户说：$chatIn$\n欢迎使用 Soyori！\n价格：$$99",
      "output": "$chatOut"
    }
  ]
}
